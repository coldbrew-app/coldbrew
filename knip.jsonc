{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.ts"],
      "ignoreBinaries": ["just", "go"],
      // Knip does not parse justfile recipes, where these tools are invoked.
      "ignoreDependencies": [
        "@tanstack/intent",
        "concurrently",
        "dbmate",
        "oxfmt",
        "oxlint",
        "oxlint-tsgolint",
      ],
    },
    "apps/web": {
      "ignore": ["src/components/ui/**"],
    },
  },
}
