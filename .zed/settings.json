{
  "format_on_save": "on",
  "formatter": {
    "external": {
      "command": "bunx",
      "arguments": ["oxfmt", "--stdin-filepath", "{buffer_path}"]
    }
  },
  "languages": {
    "SQL": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "bun",
          "arguments": ["scripts/format-sql.ts", "--stdin"]
        }
      }
    }
  }
}
