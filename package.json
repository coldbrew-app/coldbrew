{
  "name": "coldbrew",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages"
  ],
  "dependencies": {
    "@dotenvx/dotenvx": "^2.19.2",
    "oxlint": "^1.79.0"
  },
  "devDependencies": {
    "@tanstack/intent": "^0.3.7",
    "@types/node": "^24.13.3",
    "concurrently": "^10.0.4",
    "oxfmt": "^0.60.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "intent": {
    "skills": [
      "@lebedevna/readonly-url",
      "@tanstack/react-start",
      "@tanstack/router-plugin",
      "@tanstack/router-core",
      "@tanstack/start-client-core",
      "@tanstack/start-server-core",
      "@trpc/client",
      "@trpc/server",
      "@trpc/tanstack-react-query"
    ],
    "exclude": [
      "@tanstack/react-start#react-start/server-components",
      "@tanstack/react-start#lifecycle/migrate-from-nextjs",
      "@tanstack/start-client-core#start-core/deployment",
      "@trpc/server#adapter-aws-lambda",
      "@trpc/server#adapter-express",
      "@trpc/server#adapter-fastify",
      "@trpc/server#adapter-standalone",
      "@trpc/server#non-json-content-types",
      "@trpc/server#server-side-calls",
      "@trpc/server#service-oriented-architecture",
      "@trpc/server#subscriptions",
      "@trpc/tanstack-react-query#react-query-classic-migration"
    ]
  }
}
