{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "minimumVersion": "3.24.0",
  // TanStack Start loads src/start.ts by convention instead of an import edge.
  "entry": ["apps/web/src/start.ts", "scripts/**/*.ts", "apps/web/src/**/*.stories.tsx"],
  "ignorePatterns": [
    "apps/alerts/**",
    "apps/chat/**",
    "apps/donations/**",
    "apps/video/**",
    "apps/web/.ladle/**",
  ],
  "ignoreFindings": ["apps/web/src/components/ui/**"],
  // These tools are invoked from justfile recipes rather than imported by TypeScript.
  "ignoreDependencies": [
    "@dotenvx/dotenvx",
    "@tanstack/intent",
    "@ladle/react",
    "concurrently",
    "dbmate",
    "oxfmt",
    "oxlint",
    "oxlint-tsgolint",
  ],
  "rules": {
    "boundary-violation": "off",
    "policy-violation": "off",
  },
}
